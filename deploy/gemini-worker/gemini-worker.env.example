# Copy to /etc/factoryos/gemini-worker.env (sudo install -m 600 -o root -g root ...), then fill in on the host.
# Values are never committed, never pasted into chat.
FACTORYOS_URL=https://blackboxlab-factoryos.onrender.com
# FACTORY_CLAUDE_WORKER_TOKEN=...  Relay worker credential (roadmap-claim). The runbook appends it from
#   /etc/factoryos/claude-worker.env without printing it. Required.
# FACTORY_OPERATOR_WORKER_TOKEN=... Optional lane heartbeat for the Workers board; must equal the server's value.
# Distinct Relay identity for this lane (the Claude worker keeps claude-<host>).
FACTORY_WORKER_NODE_ID=gemini-ec2
# Absolute path of the gemini binary and a PATH that contains node 20+ (see runbook step 3).
# FACTORY_GEMINI_BIN=/home/ec2-user/.nvm/versions/node/v20.x.y/bin/gemini   (runbook step 6 appends the real one)
# PATH=/home/ec2-user/.nvm/versions/node/v20.x.y/bin:/usr/local/bin:/usr/bin:/bin
# Bounds (seconds). Task timeout is clamped to 600..7200.
AUTOPILOT_TASK_TIMEOUT_SECONDS=3600
GEMINI_QUOTA_BACKOFF_SECONDS=1800
GEMINI_DAILY_QUOTA_BACKOFF_SECONDS=21600
# Do NOT add GEMINI_API_KEY, GOOGLE_API_KEY, GOOGLE_GENAI_USE_VERTEXAI, GOOGLE_APPLICATION_CREDENTIALS,
# GOOGLE_CLOUD_PROJECT or GOOGLE_GEMINI_BASE_URL here: the worker refuses to start with any of them (zero spend).

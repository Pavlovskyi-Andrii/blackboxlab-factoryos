# Claude Code auth: prefer an interactive Pro/Max subscription login on the trusted runner.
# Run "claude", then /login -> Claude account with subscription, and verify with /status.
# Keep ANTHROPIC_API_KEY unset or Claude Code will use separately billed PAYG API usage.
# For CI/headless environments where your Claude plan supports it, CLAUDE_CODE_OAUTH_TOKEN can be used.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# FactoryOS Claude Pro Worker pairing (token is copied from FactoryOS -> Connections).
FACTORYOS_URL=https://blackboxlab-factoryos.onrender.com
# FACTORY_CLAUDE_WORKER_TOKEN=
# AUTOPILOT_REPO=/path/to/blackboxlab-factoryos

# Owner escalation. Keep the bot token out of Git/chat.
# TG_TOKEN=
# TG_CHAT_ID=              # optional manual fallback; normal flow uses secure pairing
TG_PAIR_TIMEOUT_SECONDS=600

AUTOPILOT_MAX_FAILS=3
AUTOPILOT_MAX_TURNS=80
AUTOPILOT_TASK_TIMEOUT_SECONDS=3600
AUTOPILOT_PAUSE_SECONDS=30
AUTOPILOT_WAIT_FOR_HUMAN=0

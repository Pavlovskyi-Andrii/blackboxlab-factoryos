.venv/
__pycache__/
*.pyc
data/
.env
.DS_Store
.env.autopilot
autopilot-ssh/
# .autopilot/ is the runner's runtime and scratch area. Only these two files are tracked; anything else there
# (state, evidence, an agent's scratch script such as ui-check.js) must never make the checkout look dirty,
# or relay_tasks refuses every ticket (2026-11-05/06: mycast.json, then ui-check.js).
.autopilot/*
!.autopilot/answers.md
!.autopilot/status.example.json
